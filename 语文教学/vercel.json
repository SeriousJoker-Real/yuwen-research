{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "installCommand": "",
  "framework": null,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@3"
    },
    "api/**/*.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/teacher", "destination": "/teacher/index.html" },
    { "source": "/student", "destination": "/student/index.html" },
    { "source": "/report", "destination": "/report/index.html" }
  ]
}
